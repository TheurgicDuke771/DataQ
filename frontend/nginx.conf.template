# Serve the built SPA AND reverse-proxy the API + MCP to the backend.

# The client-facing scheme, forwarded upstream (#1138). Prefer the edge's
# X-Forwarded-Proto (this hop never terminates TLS, so $scheme is always `http`
# and would strip cookie-`Secure` on live HTTPS — ADR 0032); fall back to
# $scheme only on a direct connection (compose / docker run).

# The origin-secret guard's static "<secret>:<secret>" map key is 81 bytes with the
# 40-char terraform secret — over the 64-byte default bucket size, which ABORTS nginx
# at startup (#1380). MUST precede the first `map`: a later placement is rejected as
# "duplicate" (parsing a map freezes the hash sizes).
map_hash_bucket_size 128;
map $http_x_forwarded_proto $dataq_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# ── Content-Security-Policy (#1387) ───────────────────────────────────────────
# Assembled here (not in nginx-security-headers.conf) because `connect-src` is a
# per-deployment runtime fact: the SPA's OIDC client hits discovery/JWKS/token
# endpoints directly. DATAQ_CSP_CONNECT_SRC is deliberately NOT derivable from
# DATAQ_AUTH_AUTHORITY (an authority carries a path, CSP matches by path prefix,
# and Azure AD's token endpoint — and Cognito's separate auth host — sit outside
# it). Its Dockerfile default is `https:`, not empty, so a BYO image upgrade
# can't silently break sign-in. An empty $dataq_csp turns the header off (nginx
# omits empty add_header values) — a supported no-rebuild off switch.
map $host $dataq_csp {
    default "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ${DATAQ_CSP_CONNECT_SRC}";
}

# ── Origin-secret guard (#1355) ───────────────────────────────────────────────
# When DATAQ_ORIGIN_SECRET is set, every request must carry the matching
# X-DataQ-Origin-Secret header or be 403'd. Two-level map encoding: with the
# secret EMPTY the key starts with ":" so `~^:` opens the guard (guard off);
# nginx's exact match beats the regex when the secret matches. The ":" delimiter
# is safe only because the terraform secret is `special = false` alphanumeric —
# a hand-provisioned secret containing ":" breaks the map.
map "${DATAQ_ORIGIN_SECRET}:$http_x_dataq_origin_secret" $dataq_origin_bad {
    default 1;
    "~^:"   0;
    "${DATAQ_ORIGIN_SECRET}:${DATAQ_ORIGIN_SECRET}" 0;
}

# Second level: exempt the load balancer's OWN health check.
map "$dataq_origin_bad:$uri" $dataq_origin_reject {
    default 0;
    "~^1:"  1;
    "1:/_alb-health" 0;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Don't advertise the exact nginx build in every response / error page.
    server_tokens off;

    # Security headers (#1387).
    include /etc/nginx/nginx-security-headers.conf;

    # Origin-secret guard (#1355, maps above).
    if ($dataq_origin_reject) {
        return 403;
    }

    # Local health endpoint for the load balancer's target-group check (exempt from the guard above
    # — the LB probes the container directly, without the CDN's header).
    location = /_alb-health {
        default_type text/plain;
        return 200 'ok';
    }

    # Runtime app config (ADR 0028).
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        # Re-included: the add_header above cancels inheritance (#1387).
        include /etc/nginx/nginx-security-headers.conf;
        return 200 'window.__DATAQ_CONFIG__={"auth":{"mode":"${DATAQ_AUTH_MODE}","authority":"${DATAQ_AUTH_AUTHORITY}","clientId":"${DATAQ_AUTH_CLIENT_ID}","apiScope":"${DATAQ_AUTH_API_SCOPE}","scope":"${DATAQ_AUTH_SCOPE}","logoutStyle":"${DATAQ_AUTH_LOGOUT_STYLE}"}};';
    }

    # Runtime DNS resolver from the running container's /etc/resolv.conf.
    resolver ${NGINX_LOCAL_RESOLVERS} ipv6=off valid=10s;

    # REST API — same-origin /api/* forwarded to the backend. proxy_pass uses a variable, so the
    # original URI isn't auto-appended.
    location /api/ {
        set $dataq_upstream "${DATAQ_API_UPSTREAM}";
        proxy_pass $dataq_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $dataq_forwarded_proto;
        # Verified above, stripped here (#1355 review): the origin secret must not ride into the
        # backend request context.
        proxy_set_header X-DataQ-Origin-Secret "";
    }

    # Liveness probe — the api's top-level /healthz (NOT under /api), proxied so it stays
    # reachable now that the api has no public ingress (ADR 0028 §5). Exact match so it
    # can't shadow an SPA route; HTTP/1.1 is mandatory — ACA ingress 426s HTTP/1.0 (#511).
    location = /healthz {
        set $dataq_upstream "${DATAQ_API_UPSTREAM}";
        proxy_pass $dataq_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $dataq_forwarded_proto;
        # Verified above, stripped here (#1355 review): the origin secret must not ride into the
        # backend request context.
        proxy_set_header X-DataQ-Origin-Secret "";
    }

    # MCP sub-app (FastMCP at /mcp). Streamable-HTTP/SSE needs HTTP/1.1 with no
    # response buffering and no hop-by-hop Connection header, or events stall.
    location /mcp {
        set $dataq_upstream "${DATAQ_API_UPSTREAM}";
        proxy_pass $dataq_upstream$request_uri;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $dataq_forwarded_proto;
        # Verified above, stripped here (#1355 review): the origin secret must not ride into the
        # backend request context.
        proxy_set_header X-DataQ-Origin-Secret "";
    }

    # Long-cache the fingerprinted build output; never cache index.html (it points at the current
    # asset hashes).
    location ~* ^/assets/.+\.(?:js|mjs|css|map|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Re-included: the add_header above cancels inheritance (#1387). nosniff
        # is the one that earns its place here — these ARE the executable assets.
        include /etc/nginx/nginx-security-headers.conf;
    }

    # SPA fallback: any non-file path returns index.html so client-side routes (deep links like
    # /results/:runId, /assets/:assetId) resolve to the app.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        # Re-included: the add_header above cancels inheritance (#1387).
        include /etc/nginx/nginx-security-headers.conf;
    }
}
