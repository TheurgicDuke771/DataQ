# Build context is the repo root; keep it small and deterministic.
.git
.github
.entire
.claude

# Frontend has its own (future) image — never ship its deps into the backend.
frontend

# Python / tooling caches
__pycache__
**/__pycache__
*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov

# Local env / secrets — never bake into an image
.env
*.env
.env.*
!.env.example

# Docs / context not needed at runtime — except the curated docs/site pages
# `mcp/docs_catalog.py` serves via the `get_doc` MCP tool (#1626). Re-including
# a path whose ancestor is excluded needs every level of the chain negated.
docs
context
*.md
!docs
!docs/site
!docs/site/**

# OS cruft
.DS_Store
