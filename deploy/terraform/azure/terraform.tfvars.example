# Copy to terraform.tfvars (gitignored) and fill in. Values here are NON-SECRET
# (identifiers + sizing).
#
# TWO REQUIRED INPUTS HAVE NO DEFAULT. Miss either and OpenTofu prompts on stdin —
# which, with stdout redirected, looks exactly like a hang. ALWAYS pass -input=false
# so a missing value fails fast instead.
#
#   1. app_db_password — SECRET. Do NOT put it in this file; pass it at apply time:
#        TF_VAR_app_db_password=... tofu apply
#      (password for the dataq_app role provisioned out-of-band on the shared
#      Postgres server — see README "Shared Postgres"). Once the state exists it can
#      be recovered with `tofu show -json`, NOT by grepping terraform.tfstate, which
#      is encrypted.
#
#   2. state_encryption_passphrase — SECRET, and unlike the above it is a
#      DATA-AT-REST KEY: it cannot be revoked or re-minted, and losing it makes
#      terraform.tfstate unrecoverable. It DOES belong in your real terraform.tfvars
#      (gitignored) so OpenTofu loads it automatically — deliberately not .env, which
#      scripts/setup.sh regenerates. Keep a second copy off the machine.
#      See README "State encryption". Generate with e.g.
#        python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   state_encryption_passphrase = "..."   # 16 chars minimum; never commit

# image_tag          = "v10"       # backend  — bump per deploy (immutable tag, not "latest")
# frontend_image_tag = "v1"        # frontend — bump per deploy (immutable tag, not "latest")
# shared_pg_server_name = "dataq-pg-wus3-3erlgd"   # the shared (harness) PG server

# Azure AD SSO (fill once the app registrations exist; empty deploys fine with
# health/docs reachable — AUTH_DEV_BYPASS stays false regardless).
# azure_tenant_id     = "00000000-0000-0000-0000-000000000000"
# azure_api_client_id = "00000000-0000-0000-0000-000000000000"
# azure_spa_client_id = "00000000-0000-0000-0000-000000000000"

# workspace_admin_emails = "you@example.com"

# Auth-widening: allow tenant GUEST (B2B / external) identities to sign in.
# Default is false (secure). Set true ONLY if your users sign in with a guest
# account invited into the tenant. This deployment sets it true.
# azure_allow_guest_users = true

# github_repo        = "TheurgicDuke771/DataQ"
# github_environment = "production"
