# Copy to terraform.tfvars (gitignored) and fill in. Values here are NON-SECRET
# (identifiers + sizing).
#
# FOUR REQUIRED INPUTS HAVE NO DEFAULT (the two secrets below, plus
# image_tag + frontend_image_tag — see #4). Miss one and OpenTofu prompts on
# stdin — which, with stdout redirected, looks exactly like a hang. ALWAYS pass
# -input=false so a missing value fails fast instead.
#
#   1. app_db_password — SECRET. Do NOT put it in this file; pass it at apply time:
#        TF_VAR_app_db_password=... tofu apply
#      (the password RDS is created with — generate one, e.g.
#        python3 -c "import secrets; print(secrets.token_urlsafe(32))")
#
#   2. state_encryption_passphrase — SECRET, and unlike the above it is a
#      DATA-AT-REST KEY: it cannot be revoked or re-minted, and losing it makes
#      terraform.tfstate unrecoverable. It DOES belong in your real terraform.tfvars
#      (gitignored) so OpenTofu loads it automatically. Keep a second copy off the
#      machine. Generate with e.g.
#        python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   state_encryption_passphrase = "..."   # 16 chars minimum; never commit

#   3+4. image_tag + frontend_image_tag — REQUIRED, no default (#1349): the
#      services run these images from the first apply, so a stale default would
#      crash-loop from minute one. Use a current main commit SHA — that's what
#      publish-images.yml tags both images with on every merge:
#        image_tag          = "<git rev-parse origin/main>"
#        frontend_image_tag = "<same SHA>"

# aws_region = "us-east-2"

# workspace_admin_emails = "you@example.com"

# github_repo        = "TheurgicDuke771/DataQ"
# github_environment = "production"

# aws_secrets_manager_prefix = "dataq"

# Email alerting (PII — leave empty to keep the channel off).
# email_username = "you@example.com"
# email_from     = "you@example.com"
# email_to       = "you@example.com"
