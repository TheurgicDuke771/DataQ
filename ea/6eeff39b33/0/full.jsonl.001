secret store, **conventional commits** \"\n\"and the API compatibility policy (rule 42) for versioning. A new interface with no fitting standard records that in its ADR.\")\nt.insert(i+1, rule); c.write_text(\"\\n\".join(t))\np=pathlib.Path(\".github/pull_request_template.md\"); s=p.read_text()\na=\"- [ ] **Published docs:** no ticket or internal-doc references; counts checked against the code\\n\"\nb=a+\"- [ ] **Open standards (rule 45):** REST changes keep `openapi.json` and `dataq-client` regenerated with typed responses; telemetry only through the OTel seam; lineage as OpenLineage; contracts as ODCS\\n\"\nassert a in s; p.write_text(s.replace(a,b,1))\np.write_text(p.read_text().replace(\"## Standards for new code (CONTRIBUTING rule 44)\",\"## Standards for new code (CONTRIBUTING rules 44–45)\"))\nm=pathlib.Path(\"CLAUDE.md\"); u=m.read_text()\nfor a2,b2 in [(\"Full list (44 rules across 8 categories)\",\"Full list (45 rules across 8 categories)\"),(\"full 44-rule working agreements\",\"full 45-rule working agreements\"),(\"Working agreements (full 44-rule list)\",\"Working agreements (full 45-rule list)\")]:\n    assert a2 in u; u=u.replace(a2,b2)\nm.write_text(u)\nEOF\nB=/opt/homebrew/Caskroom/miniconda/base/envs/dataq/bin; $B/black -q backend/tests/core/test_open_standard_seams.py; $B/ruff check -q backend/tests/core/test_open_standard_seams.py && $B/mypy backend/tests/core/test_open_standard_seams.py 2>&1 | tail -1; for s in scripts/check-docs-*.py; do $B/python $s >/dev/null 2>&1 || echo \"FAIL $s\"; done; git diff --stat | cat","description":"Add rule 45, the template line, the CLAUDE.md count, and lint the test","timeout":300000},"caller":{"type":"direct"}}]}}
