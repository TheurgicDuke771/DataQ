# ── Application env (.env.app) ────────────────────────────────────────────────
# Copy to .env.app and adjust. .env.app is gitignored.
#
# This file carries ONLY keys the app's Settings (backend/app/core/config.py)
# recognizes — Settings reads it directly on host dev and compose injects it into
# the api/worker/migrate containers via env_file. Settings runs extra="forbid",
# so an unknown key here crashes startup (the point: catch typos/stale config).
# Infra/compose-only vars (POSTGRES_*, VITE_*) live in the root .env, never here.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Points at localhost for host-side dev (uvicorn/alembic/seed on the host). The
# api/worker containers override DATABASE_URL + REDIS_URL to the in-network
# service hostnames in docker-compose.yml.
# Blank on purpose — no credentials in tracked files. Set it in your gitignored
# .env.app using the same user/password/db as your root .env, format:
#   postgresql+psycopg2://USER:PASSWORD@localhost:5432/DB
# `scripts/setup.sh` writes a matching value on first run.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# ── Observability (both optional; unset = telemetry off, a supported posture) ─
# Azure backend. Leave empty locally; set via Container Apps secret in production.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Vendor-neutral backend (#589) — spans AND logs over OTLP/HTTP. This is the
# non-Azure path (#591): `docker-compose --profile telemetry up` starts a local
# Jaeger, then set this to http://jaeger:4318 (compose) or http://localhost:4318
# (host dev) and open http://localhost:16686. Both may be set at once — that is
# the parity check (same trace in App Insights AND a local collector).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Days to retain results.sample_failures (potentially PII) before the W5 sweep nulls them.
SAMPLE_FAILURES_RETENTION_DAYS=30

# ── Azure AD SSO ──────────────────────────────────────────────────────────────
# Leave empty + set AUTH_DEV_BYPASS=true for local dev without a real tenant.
# When populated, requests must carry a valid Azure AD bearer token.
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
AZURE_SPA_CLIENT_ID=
AZURE_API_SCOPE=user_impersonation

# Allow guest (B2B / external) identities in the tenant to sign in. Default
# false → the token validator rejects guests with "Guest users not allowed".
# Set true if legitimate users sign in with a guest account.
AZURE_ALLOW_GUEST_USERS=false

# DEV ONLY. When true AND environment=dev AND Azure vars empty, auth is
# bypassed and requests resolve to a fixed dev user. Fails closed in any
# other environment regardless of this flag's value.
#
# It is the LAST rung, not the first: email OTP (below) wins over this whenever
# it is configured, and `docker compose up` configures it by default (#1150), so
# on the compose stack this flag only takes effect once you have explicitly
# cleared DATAQ_SIGNIN_EMAIL. It still governs host-side dev (uvicorn on your
# machine reading this file), which is why it stays on here.
AUTH_DEV_BYPASS=true

# Workspace-admin allowlist — comma-separated emails permitted to use the /admin
# endpoints (all-suites / all-users / access overview) and see the Admin page.
# Matched case-insensitively against the signed-in user's email. Empty = no
# admins (every /admin request 403s). Single-tenant, whole-workspace admin —
# distinct from the per-suite view/edit/admin/owner sharing roles.
WORKSPACE_ADMIN_EMAILS=

# ── Email OTP sign-in (ADR 0032) ──────────────────────────────────────────────
# The third authenticator behind the one `get_current_user` seam, for deployments
# with no IdP: a human proves they own a mailbox and gets an HttpOnly session
# cookie. PATs (dq_live_) remain the headless/MCP credential; /mcp deliberately
# does NOT accept a session. /mcp IS served in this mode (#1128) — with a PAT as
# its ONLY credential, since there is no IdP here to issue or validate a bearer.
#
# TWO COORDINATED MODE SELECTORS — keep them in step or the app looks up and
# nobody can sign in:
#   * BACKEND (this file): OTP is ON when the four AUTH_EMAIL_* values below are
#     ALL set AND at least one AUTH_OTP_ALLOWED_* entry exists. Any partial state
#     REFUSES TO BOOT, naming the missing vars.
#   * FRONTEND: the nginx-injected `DATAQ_AUTH_MODE` runtime enum (ADR 0028) must
#     be set to `otp`, or the SPA renders the OIDC flow instead of the code form.
#     The backend never reads it and cannot infer it — it is a separate contract.
#
# Deliberately SEPARATE from the EMAIL_* alerting block further down: a
# rate-limited or misconfigured alert mailer must never be able to block sign-in,
# and vice versa. The password lives in the SecretStore by NAME (put the value in
# KV_SECRET_<NAME> / the Key Vault or OpenBao secret of that name).
#
# ⚠ ON THE COMPOSE STACK THIS WHOLE BLOCK IS IGNORED (#1150) — in EVERY state,
# not just when OTP is on. `docker compose up` sets these keys in its own
# `environment:`, which beats `env_file:` unconditionally, so anything you write
# here is discarded for the api/worker containers. Clearing DATAQ_SIGNIN_EMAIL
# does NOT hand control back to this file; it blanks the block, and the stack
# falls back to dev-bypass.
#
# To point the COMPOSE stack at a real relay, keep DATAQ_SIGNIN_EMAIL set and put
# the overrides in the ROOT `.env` (or your shell), on these same key names:
#
#     AUTH_EMAIL_SMTP_HOST=smtp.example.com
#     AUTH_EMAIL_TLS_MODE=starttls          # else you send in PLAINTEXT
#     AUTH_EMAIL_USERNAME=… AUTH_EMAIL_FROM=… AUTH_EMAIL_PASSWORD_SECRET_NAME=…
#
# The values below ARE what host-side dev (uvicorn on your own machine, which
# reads this file directly) and every deployed environment use.
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_USERNAME=
AUTH_EMAIL_FROM=
AUTH_EMAIL_PASSWORD_SECRET_NAME=
# Seconds before the SMTP submission gives up. Short on purpose: this runs INSIDE
# the sign-in request, so a hung relay must fail fast into a 502 rather than hold
# a worker thread for the connect default.
AUTH_EMAIL_TIMEOUT_SECONDS=5
# Per-ADMIN cap on POST /api/v1/admin/auth-email/test, 10-minute window (#1147).
# Sits with the AUTH_EMAIL_* block it bounds: it caps the admin diagnostic that
# exercises this transport. Every call opens a REAL SMTP connection to your relay;
# without this the endpoint sits in the generic 300/min authenticated class, and a
# scripted or compromised admin token hammering it can get your sending account
# throttled or blocked by the relay — taking the real sign-in mailer down with it.
# Over the cap is a plain 429 (the caller is a known admin, so there is nothing to
# hide). Same counter store as AUTH_OTP_REQUEST_PER_EMAIL_PER_10MIN but a separate
# key space, so a diagnostic never spends somebody's sign-in quota. Fails open if
# the store is down. 0 disables the cap and re-accepts the risk.
ADMIN_EMAIL_PREFLIGHT_PER_10MIN=3

# SMTP transport variant (#1146). `starttls` (default, below) upgrades a plain
# connection on 587 — leave this unset/blank for that, the common case. Set
# `implicit` for a submission relay on :465 (SMTPS — TLS from the first byte;
# `starttls` fails against it). `none` is a deliberate PLAINTEXT downgrade — the
# code AND the SMTP password cross the wire unencrypted — for a loopback/same-host
# relay or a throwaway test rig ONLY; every send logs a loud warning naming it.
# There is no insecure-verify/skip-cert-checks option: AUTH_EMAIL_CA_BUNDLE below
# is how you reach a relay whose certificate your system doesn't already trust.
AUTH_EMAIL_TLS_MODE=starttls
# PEM path of CA certificate(s) the mailer's SMTP connection trusts INSTEAD OF the
# system store — for an internal relay signed by a private CA. Scoped to the
# mailer's own connection only; it never touches the process-wide trust store
# (unlike setting SSL_CERT_FILE for the whole api/worker, which would also
# reconfigure Key Vault/Snowflake/ADLS/webhook TLS). A path that doesn't exist
# refuses to boot, naming it.
AUTH_EMAIL_CA_BUNDLE=

# Signup gating — MANDATORY, there is no open registration (DataQ holds failing-row
# samples, which are PII). An address is eligible iff it is listed here, or its
# domain is. Comma-separated; matched case-insensitively; a leading `@` on a domain
# is tolerated. First-admin bootstrap: put your own address in BOTH this list and
# WORKSPACE_ADMIN_EMAILS, then sign in to your own mailbox — no seeded password.
AUTH_OTP_ALLOWED_EMAILS=
AUTH_OTP_ALLOWED_DOMAINS=

# Session lifetime. A FIXED horizon with no refresh token — re-running the OTP
# flow is the refresh. Logout revokes immediately; both are enforced on every
# request, not just stored.
AUTH_SESSION_TTL_HOURS=24
# `Secure` on the session cookie. Leave EMPTY to infer per request from
# X-Forwarded-Proto — which is what keeps local plain-HTTP dev working, since a
# hard-coded Secure makes the browser accept the Set-Cookie and then silently
# never send it back. Inference is only as trustworthy as the proxy: it must
# forward the REAL client-facing scheme. The reference frontend nginx does
# (#1138 — it forwards the edge's header and falls back to its own scheme only
# on a direct connection), so inference is correct on the reference stack. Behind
# YOUR OWN proxy, verify that first — or just set this to `true`, which any HTTPS
# deployment can do and which skips the header entirely. Set `false` only for a
# genuinely plain-HTTP deployment.
AUTH_SESSION_COOKIE_SECURE=
# Per-EMAIL cap on code requests, fixed 10-minute window (#1127). This is the
# tight screw on the mint surface: RATE_LIMIT_AUTH_PER_MINUTE is per-IP and cannot
# see the request body, so it cannot bound how many codes ONE mailbox receives from
# a botnet. ACTIVE EVEN WHEN RATE_LIMIT_ENABLED=false — dev and E2E turn the
# middleware off, and a mail-bomb control a test harness disables is not a control.
# A throttled request returns the SAME uniform "ok" as a successful one (a 429
# would tell an attacker which addresses are allow-listed). 0 disables it.
AUTH_OTP_REQUEST_PER_EMAIL_PER_10MIN=3
# Minimum elapsed time for a /auth/otp/request response (#1137). The uniform "ok"
# body hides eligibility; without this floor the RESPONSE TIME gave it away, since
# an eligible address pays a Redis check, two DB writes and an SMTP handshake while
# an ineligible one pays one in-memory lookup. Every uniform branch (sent /
# ineligible / throttled) is padded to this; error responses are not. 1s sits above
# a healthy relay's send while keeping sign-in snappy — raise it if your relay is
# routinely slower. 0 disables the floor and fully re-opens the timing channel.
AUTH_OTP_REQUEST_MIN_SECONDS=1.0
# The same floor for /auth/otp/verify (#1141). Every rejected code answers an
# identical 401, but an address WITH a live code outstanding pays an extra UPDATE
# + commit that an address without one never pays — and a code is minted ONLY for
# an allow-listed address, so one /auth/otp/request against the address being
# probed (uniform "ok" either way, revealing nothing itself) is what creates that
# difference, for the price of one per-email quota slot. Every 401 is
# padded to this; a SUCCESSFUL verification is not (a 200 already separates itself
# for a caller who knows the code). 0.5s is half the request-side floor because
# there is no SMTP tail to clear here. 0 disables it and re-opens the channel.
AUTH_OTP_VERIFY_MIN_SECONDS=0.5
# Daily purge of otp_codes rows (spent/expired sign-in attempts) older than this
# many hours (#1136). Hygiene, not a security control — the caps above are the
# security — so comfortably longer than the 10-minute code TTL is fine. A
# non-positive value is guarded in the sweep itself (a no-op), not here.
OTP_CODES_RETENTION_HOURS=24

# ── Secret store ──────────────────────────────────────────────────────────────
# 'openbao' = OpenBao / Vault over the KV v2 API (default; ADR 0039). Lets the API
#             and Celery worker share a credential the API writes at runtime —
#             needed by connection-driven worker runs (#86) — and, unlike the
#             plaintext Redis store it replaced, encrypts at rest behind an auth
#             boundary. api + worker both load this file, so they agree on the mode.
#             `docker compose up` starts the vault; it is DEV MODE (in-memory), so
#             a restart drops stored credentials and connections need re-entering.
# 'env'     = read connection secrets from KV_SECRET_<NAME> env vars (per-process,
#             so it CANNOT serve the compose stack — the worker won't see what the
#             api wrote). Host-only dev.
# 'azure_key_vault' = read from Azure Key Vault (staging / prod); requires
#                     AZURE_KEY_VAULT_URL. Auth via DefaultAzureCredential.
#
# 'redis' was REMOVED in ADR 0039 (it kept credentials in plaintext). Setting it
# raises at startup with the migration path rather than failing obscurely.
SECRET_STORE=openbao
AZURE_KEY_VAULT_URL=

# OpenBao/Vault address. The compose api + worker override this to the in-network
# http://openbao:8200; this value is what HOST-side dev (uvicorn/celery/alembic on
# your machine) uses against the published port.
OPENBAO_ADDR=http://localhost:8200
# KV v2 mount point. `secret` is what dev mode mounts; a production vault often
# mounts per-team paths instead.
OPENBAO_MOUNT=secret
# Blank on purpose — it is a credential, and none ship in tracked files.
# `scripts/setup.sh` generates it here AND in .env (compose needs it there to
# start the vault with the same root token). The two MUST match.
OPENBAO_TOKEN=
#
# AppRole auth (ADR 0039 phase 2, #1054) — what a production self-hosted deployment
# should run instead of a static token: the issued token is short-lived and renewed,
# so a leak is not durable, and a mid-flight expiry self-heals instead of needing a
# restart. ROLE_ID is an identifier; SECRET_ID is the credential.
# Set BOTH or NEITHER — a partial config is rejected at startup rather than silently
# falling back to OPENBAO_TOKEN.
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=

# NOTE on 'env' mode: KV_SECRET_<UPPER_SNAKE_NAME> values are read by the secret
# store straight from the process environment — do NOT add them to this file.
# Settings runs extra="forbid" and would reject them as unknown keys. Supply them
# as real env vars instead: `export KV_SECRET_SNOWFLAKE_UAT_FINANCE=...` for host
# dev, or a compose `environment:` entry for the api + worker services. The name
# matches Connection.secret_ref (e.g. 'snowflake-uat-finance').

# ── CORS ──────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API cross-origin (the Static-Web-App ↔
# Container-Apps split in prod). Comma-separated; empty = no cross-origin (dev
# uses the Vite proxy, same-origin). e.g. https://app.example.com,https://dataq.example.com
CORS_ALLOW_ORIGINS=

# Public base URL of the deployed API (scheme+host, no trailing slash). Used to
# assemble the inbound orchestration-webhook URLs shown in the admin webhook-config
# surface (#490). Empty = fall back to the request's own base URL. e.g.
# https://dataq.example.com
PUBLIC_BASE_URL=

# Host values the FastMCP transport guard accepts on /mcp (#728). Comma-separated;
# empty keeps the Azure Container Apps default (*.azurecontainerapps.io, api,
# localhost, 127.0.0.1) — set this for any other deploy target whose proxy forwards
# a different upstream Host, or /mcp answers 421.
MCP_ALLOWED_HOSTS=

# ── Request rate limiting (#725, ADR 0035) ──────────────────────────────────────
# Fixed-window (60s) throttle on every public surface — REST, the orchestration
# webhooks, and the mounted /mcp app. Authenticated traffic buckets per
# sha256(bearer); everything else per client-IP. Fail-open (a Redis outage
# disables limiting, logged). Defaults are generous — tighten
# RATE_LIMIT_WEBHOOK_PER_MINUTE to your orchestrator's callback cadence.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
RATE_LIMIT_UNAUTHENTICATED_PER_MINUTE=120
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
# Per-IP ceiling across ALL webhook buckets from one IP (#785) — bounds the
# aggregate one IP can spend across provider buckets; each of adf/airflow/dbt has
# its own bucket at RATE_LIMIT_WEBHOOK_PER_MINUTE above, and without this a caller
# could multiply its budget by rotating providers.
RATE_LIMIT_WEBHOOK_IP_PER_MINUTE=240
# Strict per-IP cap on /api/v1/auth/* (OTP mint/verify, #1127) — checked before
# the bearer branch so a token can't dodge it. This is the BACKSTOP; the tight
# screw is the per-email counter (AUTH_OTP_REQUEST_PER_EMAIL_PER_10MIN above).
# Note per-IP buckets fold onto RATE_LIMIT_IPV4_PREFIX (default /24), so a whole
# corporate-NAT egress range shares this cap — raise it if your users sign in from
# behind one (see deploy/README.md).
RATE_LIMIT_AUTH_PER_MINUTE=10
# Per-IP ceiling across ALL bearer buckets from one IP — the rotated-token
# backstop (a fresh random Bearer per request can't mint unlimited fresh buckets).
RATE_LIMIT_IP_PER_MINUTE=1200
# Number of trusted proxies that append X-Forwarded-For in your deployment; the
# real client is picked that many hops from the right. 1 for a single-proxy /
# compose setup (rightmost); 3 for the ACA public-envoy→nginx→internal-envoy chain.
RATE_LIMIT_XFF_TRUSTED_HOPS=1
# Per-IP buckets key on this address PREFIX, not the full address (#789) — a
# rotating NAT/proxy pool inside one allocation shares one bucket instead of
# diluting the cap across sibling /32s or /128s. /32 and /128 disable grouping;
# widen or narrow per deployment (a CGNAT-heavy user base may warrant /32).
RATE_LIMIT_IPV4_PREFIX=24
RATE_LIMIT_IPV6_PREFIX=64

# ── Orchestration webhook secret NAMES (not values) ─────────────────────────────
# SecretStore *keys* (not the secrets themselves) for the ADF webhook shared
# secret (ADR 0006) and the Airflow / dbt callback HMAC signing keys (ADR 0007 /
# ADR 0029). The values resolve via the SecretStore (KV_SECRET_<NAME> in env
# mode; the KV secret of the same name in azure_key_vault mode).
ADF_WEBHOOK_SECRET_NAME=adf-webhook-secret
AIRFLOW_WEBHOOK_SECRET_NAME=airflow-webhook-secret
DBT_WEBHOOK_SECRET_NAME=dbt-webhook-secret

# ── Alerting — Teams / Slack / Email (all optional; unset = that channel off) ───
# Webhook URLs carry a token, so they live in the SecretStore by NAME (set the
# *_SECRET_NAME key; put the URL value in KV_SECRET_<NAME> / Key Vault). The
# *_ALLOWED_HOSTS are SSRF allowlists for the server-side POST.
TEAMS_WEBHOOK_SECRET_NAME=
TEAMS_WEBHOOK_ALLOWED_HOSTS=webhook.office.com,logic.azure.com
SLACK_WEBHOOK_SECRET_NAME=
SLACK_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com
# Email (SMTP) — active only when EMAIL_TO + EMAIL_USERNAME + EMAIL_PASSWORD_SECRET_NAME
# are all set. The password lives in the SecretStore by name; STARTTLS on the port.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_FROM=
EMAIL_TO=
EMAIL_PASSWORD_SECRET_NAME=

# ── Comparison checks (ADR 0015) ─────────────────────────────────────────────────
# Default per-side row cap for `comparison` checks. Both sides materialize in
# worker memory for the diff, so this is a memory guardrail, not a tuning knob —
# over-cap runs fail fast rather than silently truncate the diff. A check's
# config.max_rows overrides it.
COMPARISON_MAX_ROWS=100000

# ── Connection poll-health alerting (#837) ─────────────────────────────────────
# How many CONSECUTIVE failed orchestration polls (10-min cadence) a connection may
# rack up before DataQ alerts. Fires on the CROSSING only — a connection dead for a
# week alerts once, not 1,008 times — and signals recovery. 0 disables the push (the
# in-app failing-poll badge + lineage warning stay either way).
ORCHESTRATION_POLL_FAILURE_ALERT_THRESHOLD=3

# ── Stuck-run reaper (#309) ─────────────────────────────────────────────────────
# A run left non-terminal (queued/running) past this many minutes is failed by the
# beat janitor. Must exceed the longest plausible suite run. <=0 disables the sweep.
STUCK_RUN_THRESHOLD_MINUTES=60

# ── Worker lifecycle ─────────────────────────────────────────────────────────────
# Recycle a Celery prefork child once its resident size passes this many KiB
# (#755), so one large materialisation can't ratchet the worker's baseline memory
# up run-over-run. 0 disables. 1_500_000 KiB (~1.4 GiB) sits under a 2 GiB worker
# with headroom for the parent + a starting child.
WORKER_MAX_MEMORY_PER_CHILD_KB=1500000
# Beat liveness watchdog (#904): the worker checks every BEAT_WATCHDOG_INTERVAL_S
# seconds that Celery beat has ticked within the last BEAT_WATCHDOG_STALE_AFTER_S
# seconds, and exits — so the platform restarts it — if not. Catches an "alive but
# doing nothing" worker (container Healthy, zero scheduled tasks executed).
# STALE_AFTER must be several multiples of the fastest beat interval (60s
# dispatch_due_schedules); it also doubles as the boot grace period. <=0 on
# STALE_AFTER disables the watchdog entirely.
BEAT_WATCHDOG_INTERVAL_S=60
BEAT_WATCHDOG_STALE_AFTER_S=600

# ── Orphan-asset sweep (#770, ADR 0034) ──────────────────────────────────────────
# An `assets` row whose last_seen is frozen past this many days AND that no
# suite/run/lineage_edge still references is deleted by the beat janitor. Keep
# generous — must outlive the slowest suite schedule + lineage poll cadence.
# <=0 disables the sweep.
ASSET_ORPHAN_RETENTION_DAYS=30

# ── Warehouse inventory sync (#919, ADR 0040) ────────────────────────────────────
# Per-connection cap on tables synced per daily tick. Opt-in lives on the
# CONNECTION ("Inventory sync" toggle on the Snowflake/UC forms), not here.
# Overflow syncs the first N in catalog order and logs `inventory_sync_truncated`
# — never a silent cap. <=0 removes the bound. Default:
# ASSET_INVENTORY_MAX_TABLES=2000

# ── Orphan-SECRET sweep (#1059) ──────────────────────────────────────────────────
# A credential write is not part of the DB transaction that creates the row
# referencing it, so a failed create/update leaves the credential in the vault
# forever, unreferenced — and nothing else cleans it up. This daily janitor
# reconciles the store against the rows that should own its entries.
#
# The grace period must comfortably exceed the longest window in which a secret
# legitimately exists without its row committed. <=0 disables the sweep.
SECRET_ORPHAN_GRACE_DAYS=30
# The destructive half, OFF by default — deliberately unlike the other janitors.
# What this deletes is a live warehouse credential, unrecoverable once purged
# (ADR 0039 §7 purges KV metadata, it does not soft-delete). Leave it off, read the
# reported counts on a real vault first, then turn it on.
SECRET_ORPHAN_PURGE=false
#
# SHARED-MOUNT CONSTRAINT, read before enabling the purge. The names DataQ owns are
# identified by a per-PRODUCT prefix (`conn-`, `suite-notif-`), not a per-install one.
# Two DataQ deployments pointed at the SAME vault mount — staging and prod is the
# obvious case — therefore each see the other's entries as unowned, and with the purge
# on they would delete each other's live credentials. Give each deployment its own
# OPENBAO_MOUNT (or its own vault) first.
#
# OpenBao policy: the sweep additionally needs `list` on `<mount>/metadata/` and
# `read` on `<mount>/metadata/*`. Without them it cannot date secrets and reports
# them under `unknown_age` — never purged, but also never resolved.

# ── Lineage: OpenLineage emit + catalog pull (ADR 0034, #758/#762) — dark by default ──
# Emit DQ RunEvents to an OpenLineage receiver (Marquez/collector). Unset → dark.
#   OPENLINEAGE_URL=http://marquez:5000/api/v1/lineage
OPENLINEAGE_URL=
# Force the emitter dark even if OPENLINEAGE_URL is set (truthy = off).
# Commented out, not blank: this is a bool, and a present-but-empty value is not a
# parseable boolean, so shipping it blank made a fresh install unbootable (#1072).
# OPENLINEAGE_DISABLED=false
# Catalog-pull provider: pulls a lineage graph back into `lineage_edges`
# (source='marquez') via the daily `refresh_lineage_pull` beat task. Unset → no pull.
# Only `marquez` is implemented (DataHub/OpenMetadata/Purview deferred behind the seam).
#   LINEAGE_PROVIDER=marquez
LINEAGE_PROVIDER=
# Base URL of the Marquez server (required when LINEAGE_PROVIDER=marquez).
#   MARQUEZ_URL=http://marquez:5000
MARQUEZ_URL=
# Warehouse-native lineage pull (ADR 0034, #858) — a SEPARATE source from the
# OpenLineage pull above: true on the WORKER ONLY runs a daily sweep straight off
# each Snowflake/UC connection's own lineage views (Snowflake ACCOUNT_USAGE /
# OBJECT_DEPENDENCIES; UC system.access.table_lineage) — no dbt/manifest hop. Dark
# by default: those views need a grant the connection principal may not hold.
# Commented out, not blank — same #1072 rule as below (a bool with a present-but-
# empty value fails to parse and makes a fresh install unbootable). Default:
# WAREHOUSE_LINEAGE_ENABLED=false
# Staleness surface (#1091): a warehouse lineage source last refreshed more than
# this many hours ago is flagged STALE in the asset view, independent of
# error/degraded — a refresh loop that silently stops must not render as healthy.
# Default 48 (2x the daily refresh cadence); 0 disables.
# Commented out, not blank: an int, and a present-but-empty value is not a
# parseable integer — shipping it blank makes a fresh install unbootable (#1072).
# LINEAGE_STALE_AFTER_HOURS=48
# Snowflake GET_LINEAGE seed cap (#892): how many enumerated tables the Enterprise
# per-seed traversal walks per refresh (two round trips each — upstream + downstream).
# Overflow walks the first N in catalog order and logs `get_lineage_seeds_truncated`
# — never a silent cap. <=0 removes the bound. Default:
# Commented out, not blank — same #1072 rule as above.
# WAREHOUSE_LINEAGE_MAX_SEEDS=500

# ── Workspace poll-staleness alert (#1052) ──────────────────────────────────────
# Alert (via the workspace Teams/Slack/email channels) when NO orchestration
# connection has been polled for this many seconds — the API-side dead-loop
# detector; it fires precisely when the worker is too broken to alert for itself.
# Default 1800 (3x the 10-min poll interval); 0 disables the check loop.
# Commented out, not blank — same #1072 rule as above.
# POLL_STALENESS_ALERT_AFTER_S=1800

# ── Trigger-binding env near-miss window (#1186/#1199) ──────────────────────────
# How far back a recorded env mismatch — a pipeline/DAG run kept succeeding in one
# env while the only enabled trigger binding for it is scoped to another, so the
# binding never fired — still counts as "current" on `GET /orchestration/near-misses`
# and the Suite Triggers panel badge. The record's timestamp is bumped on every
# re-observation, so anything older than this has gone quiet (binding re-pointed,
# connection deleted, pipeline stopped) and reads as resolved rather than ongoing.
# Default 48 (comfortably longer than a daily schedule, so a once-a-day DAG's
# mismatch doesn't flicker between its runs); 0 disables the surface.
# Commented out, not blank — same #1072 rule as above.
# TRIGGER_ENV_NEAR_MISS_RECENT_HOURS=48

# ── Snowflake probe (Week-1 exit-gate endpoint) — all optional ──────────────────
# Config for the single seeded dev Snowflake connection the probe runs against.
# When unset the probe still creates + dispatches a run, which fails-soft (no live
# warehouse). PROBE_SNOWFLAKE_SECRET_REF names the SecretStore entry with the password.
PROBE_SNOWFLAKE_ACCOUNT=
PROBE_SNOWFLAKE_USER=
PROBE_SNOWFLAKE_DATABASE=
PROBE_SNOWFLAKE_SCHEMA=
PROBE_SNOWFLAKE_WAREHOUSE=
PROBE_SNOWFLAKE_ROLE=
PROBE_SNOWFLAKE_TABLE=
PROBE_SNOWFLAKE_SECRET_REF=
