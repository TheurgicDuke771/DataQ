{"parentUuid":"0a4ec866-a8b9-4fb2-aa41-6510e6274f4c","isSidechain":true,"promptId":"7f13480b-1b89-4b4d-8383-45166d86273d","agentId":"a235eb573f7e4cd2a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XzT1waYtHVARUonBG8uqDQ","type":"tool_result","content":"diff --git a/backend/app/services/result_rollup.py b/backend/app/services/result_rollup.py\nindex 3f06b4a70..d8a05838b 100644\n--- a/backend/app/services/result_rollup.py\n+++ b/backend/app/services/result_rollup.py\n@@ -61,7 +61,7 @@ def unrolled_runs_statement(limit: int) -> Select[tuple[uuid.UUID]]:\n # are upserted in key order: two transactions touching the same buckets lock them alike.\n # The data-modifying CTEs run to completion whether or not the final SELECT reads them.\n _ADD_SQL = \"\"\"\n-WITH claimed AS (\n+WITH {pick}claimed AS (\n     UPDATE runs SET results_rolled_up_at = now()\n     WHERE {which}\n     RETURNING id, suite_id\n@@ -77,12 +77,17 @@ def unrolled_runs_statement(limit: int) -> Select[tuple[uuid.UUID]]:\n SELECT (SELECT count(*) FROM claimed) AS runs\n \"\"\"\n _ADD_ONE = text(\n-    _ADD_SQL.format(which=\"id = :run_id AND status = 'succeeded' AND results_rolled_up_at IS NULL\")\n+    _ADD_SQL.format(\n+        pick=\"\", which=\"id = :run_id AND status = 'succeeded' AND results_rolled_up_at IS NULL\"\n+    )\n )\n+# The batch is picked once, in its own CTE. As an `IN (subquery)` the planner may rescan it\n+# per outer row, and each rescan skips the rows already claimed and takes more (#2753).\n _ADD_PENDING = text(\n     _ADD_SQL.format(\n-        which=\"id IN (SELECT id FROM runs WHERE status = 'succeeded' \"\n-        \"AND results_rolled_up_at IS NULL ORDER BY id LIMIT :limit FOR UPDATE SKIP LOCKED)\"\n+        pick=\"picked AS MATERIALIZED (SELECT id FROM runs WHERE status = 'succeeded' \"\n+        \"AND results_rolled_up_at IS NULL ORDER BY id LIMIT :limit FOR UPDATE SKIP LOCKED), \",\n+        which=\"id IN (SELECT id FROM picked)\",\n     )\n )\n #: Above this many un-added runs a read counts from `results` alone (see `status_counts`).\ndiff --git a/backend/tests/services/test_result_rollup.py b/backend/tests/services/test_result_rollup.py\nindex 78c082364..23849cdd4 100644\n--- a/backend/tests/services/test_result_rollup.py\n+++ b/backend/tests/services/test_result_rollup.py\n@@ -72,8 +72,9 @@ def _run(\n     *,\n     status: str = \"succeeded\",\n     check: Check | None = None,\n+    run_id: uuid.UUID | None = None,\n ) -> Run:\n-    run = Run(suite_id=suite.id, status=status, created_at=at)\n+    run = Run(id=run_id, suite_id=suite.id, status=status, created_at=at)\n     db.add(run)\n     db.flush()\n     for result_status in statuses:\n@@ -762,3 +763,33 @@ def reconcile() -> None:\n                 )\n             )\n         assert held == 3\n+\n+\n+def test_a_sweep_batch_never_claims_more_than_its_limit_whatever_the_plan(\n+    db_session: Any,\n+) -> None:\n+    \"\"\"#2753: with `runs` believed empty, the planner made the claim's `LIMIT … SKIP LOCKED`\n+    subquery the rescanned inner side of a semi join. Each rescan skipped the rows already\n+    claimed and took the next ones, so a batch claimed past its limit. Inserted in id order,\n+    the old statement took the whole backlog in one batch.\"\"\"\n+    db_session.execute(text(\"ANALYZE runs\"))\n+    suite = _suite(db_session)\n+    for hours, run_id in enumerate(sorted(uuid.uuid4() for _ in range(6))):\n+        _run(db_session, suite, NOW - timedelta(hours=hours), [\"pass\"], run_id=run_id)\n+    db_session.commit()\n+    off = (\n+        \"enable_hashjoin\",\n+        \"enable_mergejoin\",\n+        \"enable_hashagg\",\n+        \"enable_material\",\n+        \"enable_sort\",\n+    )\n+    for setting in off:\n+        db_session.execute(text(f\"SET {setting} = off\"))\n+    try:\n+        claimed = [result_rollup.roll_up_pending(db_session, limit=2) for _ in range(4)]\n+    finally:\n+        db_session.execute(text(\"RESET ALL\"))\n+\n+    assert claimed == [2, 2, 2, 0]\n+    assert sum(_table(db_session).values()) == 6\ndiff --git a/changelog.d/2753.fixed.md b/changelog.d/2753.fixed.md\nnew file mode 100644\nindex 000000000..bee48c63f\n--- /dev/null\n+++ b/changelog.d/2753.fixed.md\n@@ -0,0 +1,4 @@\n+**A results-rollup sweep batch could claim more runs than its batch size.** When the database's\n+statistics said `runs` was nearly empty, the planner could re-run the batch's `LIMIT` once per\n+row, so one sweep could take the whole backlog in a single transaction. The counts were always\n+right; the batch bound now holds whatever plan is chosen.","is_error":false}]},"uuid":"56d76f13-5976-4584-b4af-dbc3cae3b643","timestamp":"2026-11-28T05:01:37.675Z","serverClassifierContext":{"request":"80ba34dc-40c2-48b0-bac5-f6df70d1291c","context":{"git_state":{"cwd":"/Users/arijit/Coding/Python/DataQ","root":"/Users/arijit/Coding/Python/DataQ","branch":"fix/issue-2753-sweep-batch-overclaim","default_branch":null,"status":null,"visibility":{"origin":{"host":"github.com","remote":"TheurgicDuke771/DataQ","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"TheurgicDuke771/DataQ","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"TheurgicDuke771/DataQ","visibility":"unknown"}]}},"live_cwd":"/Users/arijit/Coding/Python/DataQ","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"0a4ec866-a8b9-4fb2-aa41-6510e6274f4c","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-vscode","cwd":"/Users/arijit/Coding/Python/DataQ","sessionId":"b8b83cc0-a8fa-4ad8-8284-2deb9d1429b6","version":"2.1.332","gitBranch":"fix/issue-2753-sweep-batch-overclaim"}
