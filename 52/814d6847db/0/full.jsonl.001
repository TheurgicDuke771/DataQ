et().union(*(_offenders(name) for name in _PROPRIETARY_TELEMETRY)) == set()\n\n\ndef test_openlineage_is_imported_only_by_the_lineage_package() -> None:\n    assert _offenders(\"openlineage\", allowed_dir=_LINEAGE_SEAM_DIR) == set()\n\n\ndef test_the_scan_sees_the_seams_it_guards() -> None:\n    modules = {module for _, module in _imports()}\n    assert any(m.startswith(\"opentelemetry\") for m in modules)\n    assert any(m.startswith(\"openlineage\") for m in modules)\n","userModified":false},"sourceToolAssistantUUID":"69206247-95f1-4bfa-bb35-e0284aa1ae6a","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"/Users/arijit/Coding/Python/DataQ","sessionId":"641b53ca-47b3-45aa-9ab6-6db8524d561d","version":"2.1.301","gitBranch":"fix/v13-ui-rule44"}
