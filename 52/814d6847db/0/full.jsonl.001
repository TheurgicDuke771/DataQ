\t@pytest.fixture(scope=\"module\")\n76\tdef spec() -> dict[str, Any]:\n77\t    return app.openapi()\n78\t\n79\t\n80\t@pytest.fixture(scope=\"module\")\n...\n101\t        },\n102\t        {\"responses\": {\"200\": {\"description\": \"ok\"}}},\n103\t    ],\n104\t)\n105\tdef test_an_untyped_success_is_refused(op: dict[str, Any]) -> None:\n106\t    assert _untyped_successes(op)\n107\t\n108\t\n109\tdef test_a_binary_body_the_client_would_read_as_text_is_refused() -> None:\n110\t    binary = {\"schema\": {\"type\": \"string\", \"format\": \"binary\"}}\n111\t    op = {\"responses\": {\"200\": {\"content\": {\"text/csv\": binary}}}}\n112\t    assert _unmapped_media(op, {}) == [\"text/csv\"]\n113\t    assert _unmapped_media(op, {\"text/csv\": \"application/octet-stream\"}) == []\n114\t\n115\t\n116\tdef test_a_response_with_no_parseable_media_is_refused() -> None:\n117\t    op = {\"responses\": {\"200\": {\"content\": {\"application/pdf\": {\"schema\": {\"type\": \"string\"}}}}}}\n118\t    assert _unmapped_media(op, {}) == [\"application/pdf\"]\n119\t\n120\t\n121\tdef test_a_text_alternate_beside_json_passes() -> None:\n122\t    op = {\n123\t        \"responses\": {\n124\t            \"200\": {\n125\t                \"content\": {\n126\t                    \"application/json\": {\"schema\": {\"type\": \"object\"}},\n127\t                    \"application/yaml\": {\"schema\": {\"type\": \"string\"}},\n128\t                }\n129\t            }\n130\t        }\n131\t    }\n132\t    assert _unmapped_media(op, {}) == []\n\n<total_tokens>14982366 tokens left</total_tokens>\n\nConcise output style is active. Be concise: lead with the result, skip preamble and narration, keep only what the user needs."}]}}
