.get(\"content\") or {}\n        if not content:\n            bad.append(f\"{code}: no content\")\n        bad.extend(\n            f\"{code} {media}: schema constrains nothing\"\n            for media, body in content.items()\n            if not _constrains(body.get(\"schema\"))\n        )\n    return bad\n\n\ndef _unmapped_media(op: dict[str, Any], overrides: dict[str, str]) -> list[str]:\n    \"\"\"Non-JSON success media the client generator would read as text or skip.\"\"\"\n    return [\n        media\n        for code, response in op.get(\"responses\", {}).items()\n        if code.startswith(\"2\")\n        for media in (response.get(\"content\") or {})\n        if media != _PARSED_AS_JSON and overrides.get(media) != \"application/octet-stream\"\n    ]\n\n\n@pytest.fixture(scope=\"module\")\ndef spec() -> dict[str, Any]:\n    return app.openapi()\n\n\n@pytest.fixture(scope=\"module\")\ndef overrides() -> dict[str, str]:\n    config = yaml.safe_load(_CLIENT_CONFIG.read_text())\n    return dict(config.get(\"content_type_overrides\") or {})\n\n\ndef test_the_spec_has_operations(spec: dict[str, Any]) -> None:\n    assert len(_operations(spec)) > 100\n\n\ndef test_every_success_response_is_typed(spec: dict[str, Any]) -> None:\n    untyped = {name: bad for name, op in _operations(spec) if (bad := _untyped_successes(op))}\n    assert untyped == {}\n\n\ndef test_every_file_download_is_mapped_for_the_client(\n    spec: dict[str, Any], overrides: dict[str, str]\n) -> None:\n    unmapped = {name: bad for name, op in _operations(spec) if (bad := _unmapped_media(op, overrides))}\n    assert unmapped == {}\n\n\n@pytest.mark.parametrize(\n    \"op\",\n    [\n        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {}}}}}},\n        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {\"title\": \"R\"}}}}}},\n        {\n            \"responses\": {\n                \"201\": {\"content\": {\"application/json\": {\"schema\": {\"type\": \"object\"}}}},\n                \"200\": {\"content\": {\"application/json\": {\"schema\": {}}}},\n            }\n        },\n        {\"responses\": {\"200\": {\"description\": \"ok\"}}},\n    ],\n)\ndef test_an_untyped_success_is_refused(op: dict[str, Any]) -> None:\n    assert _untyped_successes(op)\n\n\ndef test_a_file_download_the_client_would_read_as_text_is_refused() -> None:\n    op = {\"responses\": {\"200\": {\"content\": {\"application/pdf\": {\"schema\": {\"type\": \"string\"}}}}}}\n    assert _unmapped_media(op, {}) == [\"application/pdf\"]\n    assert _unmapped_media(op, {\"application/pdf\": \"application/octet-stream\"}) == []\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":22,"lines":["-\"\"\"Every REST operation is described in the OpenAPI spec well enough to be a contract.\"\"\"","+\"\"\"Every success response in the OpenAPI spec is typed well enough for the generated client."," ","+Summaries and tags are held by ``test_main.py::test_every_api_endpoint_has_summary_and_tags``.","+\"\"\"","+"," from __future__ import annotations"," ","+from pathlib import Path"," from typing import Any"," "," import pytest","+import yaml"," "," from backend.app.main import app"," "," _METHODS = (\"get\", \"post\", \"put\", \"patch\", \"delete\")","+_CLIENT_CONFIG = Path(__file__).resolve().parents[3] / \"packages/dataq-client/openapi-config.yaml\"","+_CONSTRAINING_KEYS = (\"type\", \"$ref\", \"allOf\", \"anyOf\", \"oneOf\", \"enum\", \"const\")","+_PARSED_AS_JSON = \"application/json\""," "," "," def _operations(spec: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:"]},{"oldStart":20,"oldLines":42,"newStart":28,"newLines":83,"lines":["     ]"," "," ","-def _typed_success(op: dict[str, Any]) -> bool:","+def _constrains(schema: dict[str, Any] | None) -> bool:","+    return bool(schema) and any(key in schema for key in _CONSTRAINING_KEYS)  # type: ignore[union-attr]","+","+","+def _untyped_successes(op: dict[str, Any]) -> list[str]:","+    bad = []","     for code, response in op.get(\"responses\", {}).items():","-        if not code.startswith(\"2\"):","+        if not code.startswith(\"2\") or code == \"204\":","             continue","-        if code == \"204\":","-            return True","-        content = response.get(\"content\", {})","-        if content and all(media.get(\"schema\") for media in content.values()):","-            return True","-    return False","+        content = response.get(\"content\") or {}","+        if not content:","+            bad.append(f\"{code}: no content\")","+        bad.extend(","+            f\"{code} {media}: schema constrains nothing\"","+            for media, body in content.items()","+            if not _constrains(body.get(\"schema\"))","+        )","+    return bad"," "," ","+def _unmapped_media(op: dict[str, Any], overrides: dict[str, str]) -> list[str]:","+    \"\"\"Non-JSON success media the client generator would read as text or skip.\"\"\"","+    return [","+        media","+        for code, response in op.get(\"responses\", {}).items()","+        if code.startswith(\"2\")","+        for media in (response.get(\"content\") or {})","+        if media != _PARSED_AS_JSON and overrides.get(media) != \"application/octet-stream\"","+    ]","+","+"," @pytest.fixture(scope=\"module\")"," def spec() -> dict[str, Any]:","     return app.openapi()"," "," ","+@pytest.fixture(scope=\"module\")","+def overrides() -> dict[str, str]:","+    config = yaml.safe_load(_CLIENT_CONFIG.read_text())","+    return dict(config.get(\"content_type_overrides\") or {})","+","+"," def test_the_spec_has_operations(spec: dict[str, Any]) -> None:","     assert len(_operations(spec)) > 100"," "," ","-def test_every_operation_has_a_summary(spec: dict[str, Any]) -> None:","-    missing = [name for name, op in _operations(spec) if not op.get(\"summary\")]","-    assert missing == []","+def test_every_success_response_is_typed(spec: dict[str, Any]) -> None:","+    untyped = {name: bad for name, op in _operations(spec) if (bad := _untyped_successes(op))}","+    assert untyped == {}"," "," ","-def test_every_operation_declares_a_typed_success_response(spec: dict[str, Any]) -> None:","-    untyped = [name for name, op in _operations(spec) if not _typed_success(op)]","-    assert untyped == []","+def test_every_file_download_is_mapped_for_the_client(","+    spec: dict[str, Any], overrides: dict[str, str]","+) -> None:","+    unmapped = {name: bad for name, op in _operations(spec) if (bad := _unmapped_media(op, overrides))}","+    assert unmapped == {}"," "," ","-def test_an_untyped_json_success_is_refused() -> None:","-    op: dict[str, Any] = {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {}}}}}}","-    assert not _typed_success(op)","+@pytest.mark.parametrize(","+    \"op\",","+    [","+        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {}}}}}},","+        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {\"title\": \"R\"}}}}}},","+        {","+            \"responses\": {","+                \"201\": {\"content\": {\"application/json\": {\"schema\": {\"type\": \"object\"}}}},","+                \"200\": {\"content\": {\"application/json\": {\"schema\": {}}}},","+            }","+        },","+        {\"responses\": {\"200\": {\"description\": \"ok\"}}},","+    ],","+)","+def test_an_untyped_success_is_refused(op: dict[str, Any]) -> None:","+    assert _untyped_successes(op)"," "," ","-def test_a_file_download_with_declared_media_types_passes() -> None:","-    op = {\"responses\": {\"200\": {\"content\": {\"text/csv\": {\"schema\": {\"type\": \"string\"}}}}}}","-    assert _typed_success(op)","+def test_a_file_download_the_client_would_read_as_text_is_refused() -> None:","+    op = {\"responses\": {\"200\": {\"content\": {\"application/pdf\": {\"schema\": {\"type\": \"string\"}}}}}}","+    assert _unmapped_media(op, {}) == [\"application/pdf\"]","+    assert _unmapped_media(op, {\"application/pdf\": \"application/octet-stream\"}) == []"]}],"originalFile":"\"\"\"Every REST operation is described in the OpenAPI spec well enough to be a contract.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nimport pytest\n\nfrom backend.app.main import app\n\n_METHODS = (\"get\", \"post\", \"put\", \"patch\", \"delete\")\n\n\ndef _operations(spec: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    return [\n        (f\"{method.upper()} {path}\", op)\n        for path, ops in spec[\"paths\"].items()\n        for method, op in ops.items()\n        if method in _METHODS\n    ]\n\n\ndef _typed_success(op: dict[str, Any]) -> bool:\n    for code, response in op.get(\"responses\", {}).items():\n        if not code.startswith(\"2\"):\n            continue\n        if code == \"204\":\n            return True\n        content = response.get(\"content\", {})\n        if content and all(media.get(\"schema\") for media in content.values()):\n            return True\n    return False\n\n\n@pytest.fixture(scope=\"module\")\ndef spec() -> dict[str, Any]:\n    return app.openapi()\n\n\ndef test_the_spec_has_operations(spec: dict[str, Any]) -> None:\n    assert len(_operations(spec)) > 100\n\n\ndef test_every_operation_has_a_summary(spec: dict[str, Any]) -> None:\n    missing = [name for name, op in _operations(spec) if not op.get(\"summary\")]\n    assert missing == []\n\n\ndef test_every_operation_declares_a_typed_success_response(spec: dict[str, Any]) -> None:\n    untyped = [name for name, op in _operations(spec) if not _typed_success(op)]\n    assert untyped == []\n\n\ndef test_an_untyped_json_success_is_refused() -> None:\n    op: dict[str, Any] = {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {}}}}}}\n    assert not _typed_success(op)\n\n\ndef test_a_file_download_with_declared_media_types_passes() -> None:\n    op = {\"responses\": {\"200\": {\"content\": {\"text/csv\": {\"schema\": {\"type\": \"string\"}}}}}}\n    assert _typed_success(op)\n","userModified":false},"sourceToolAssistantUUID":"94d6f6c0-2618-4738-b024-70e67430d2ad","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"/Users/arijit/Coding/Python/DataQ","sessionId":"641b53ca-47b3-45aa-9ab6-6db8524d561d","version":"2.1.301","gitBranch":"fix/v13-ui-rule44"}
