{"parentUuid":"7b990388-1fe8-43b2-9a95-f278207cd520","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgEpeDw2f4hZo19B3W8SJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011uKgvB8QJc2oEsahcxUVEs","name":"Write","input":{"file_path":"/Users/arijit/Coding/Python/DataQ/backend/tests/api/test_openapi_contract.py","content":"\"\"\"Every success response in the OpenAPI spec is typed well enough for the generated client.\n\nSummaries and tags are held by ``test_main.py::test_every_api_endpoint_has_summary_and_tags``.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nimport yaml\n\nfrom backend.app.main import app\n\n_METHODS = (\"get\", \"post\", \"put\", \"patch\", \"delete\")\n_CLIENT_CONFIG = Path(__file__).resolve().parents[3] / \"packages/dataq-client/openapi-config.yaml\"\n_CONSTRAINING_KEYS = (\"type\", \"$ref\", \"allOf\", \"anyOf\", \"oneOf\", \"enum\", \"const\")\n_PARSED_AS_JSON = \"application/json\"\n\n\ndef _operations(spec: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    return [\n        (f\"{method.upper()} {path}\", op)\n        for path, ops in spec[\"paths\"].items()\n        for method, op in ops.items()\n        if method in _METHODS\n    ]\n\n\ndef _constrains(schema: dict[str, Any] | None) -> bool:\n    return bool(schema) and any(key in schema for key in _CONSTRAINING_KEYS)  # type: ignore[union-attr]\n\n\ndef _untyped_successes(op: dict[str, Any]) -> list[str]:\n    bad = []\n    for code, response in op.get(\"responses\", {}).items():\n        if not code.startswith(\"2\") or code == \"204\":\n            continue\n        content = response.get(\"content\") or {}\n        if not content:\n            bad.append(f\"{code}: no content\")\n        bad.extend(\n            f\"{code} {media}: schema constrains nothing\"\n            for media, body in content.items()\n            if not _constrains(body.get(\"schema\"))\n        )\n    return bad\n\n\ndef _unmapped_media(op: dict[str, Any], overrides: dict[str, str]) -> list[str]:\n    \"\"\"Non-JSON success media the client generator would read as text or skip.\"\"\"\n    return [\n        media\n        for code, response in op.get(\"responses\", {}).items()\n        if code.startswith(\"2\")\n        for media in (response.get(\"content\") or {})\n        if media != _PARSED_AS_JSON and overrides.get(media) != \"application/octet-stream\"\n    ]\n\n\n@pytest.fixture(scope=\"module\")\ndef spec() -> dict[str, Any]:\n    return app.openapi()\n\n\n@pytest.fixture(scope=\"module\")\ndef overrides() -> dict[str, str]:\n    config = yaml.safe_load(_CLIENT_CONFIG.read_text())\n    return dict(config.get(\"content_type_overrides\") or {})\n\n\ndef test_the_spec_has_operations(spec: dict[str, Any]) -> None:\n    assert len(_operations(spec)) > 100\n\n\ndef test_every_success_response_is_typed(spec: dict[str, Any]) -> None:\n    untyped = {name: bad for name, op in _operations(spec) if (bad := _untyped_successes(op))}\n    assert untyped == {}\n\n\ndef test_every_file_download_is_mapped_for_the_client(\n    spec: dict[str, Any], overrides: dict[str, str]\n) -> None:\n    unmapped = {name: bad for name, op in _operations(spec) if (bad := _unmapped_media(op, overrides))}\n    assert unmapped == {}\n\n\n@pytest.mark.parametrize(\n    \"op\",\n    [\n        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {}}}}}},\n        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {\"title\": \"R\"}}}}}},\n        {\n            \"responses\": {\n                \"201\": {\"content\": {\"application/json\": {\"schema\": {\"type\": \"object\"}}}},\n                \"200\": {\"content\": {\"application/json\": {\"schema\": {}}}},\n            }\n        },\n        {\"responses\": {\"200\": {\"description\": \"ok\"}}},\n    ],\n)\ndef test_an_untyped_success_is_refused(op: dict[str, Any]) -> None:\n    assert _untyped_successes(op)\n\n\ndef test_a_file_download_the_client_would_read_as_text_is_refused() -> None:\n    op = {\"responses\": {\"200\": {\"content\": {\"application/pdf\": {\"schema\": {\"type\": \"string\"}}}}}}\n    assert _unmapped_media(op, {}) == [\"application/pdf\"]\n    assert _unmapped_media(op, {\"application/pdf\": \"application/octet-stream\"}) == []\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1294,"cache_read_input_tokens":661556,"output_tokens":1713,"output_tokens_details":{"thinking_tokens":50},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1294,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1713,"cache_read_input_tokens":661556,"cache_creation_input_tokens":1294,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1294},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_011uKgvB8QJc2oEsahcxUVEs":{"file_path":"/Users/arijit/Coding/Python/DataQ/backend/tests/api/test_openapi_contract.py","content":"\"\"\"Every success response in the OpenAPI spec is typed well enough for the generated client.\n\nSummaries and tags are held by ``test_main.py::test_every_api_endpoint_has_summary_and_tags``.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nimport yaml\n\nfrom backend.app.main import app\n\n_METHODS = (\"get\", \"post\", \"put\", \"patch\", \"delete\")\n_CLIENT_CONFIG = Path(__file__).resolve().parents[3] / \"packages/dataq-client/openapi-config.yaml\"\n_CONSTRAINING_KEYS = (\"type\", \"$ref\", \"allOf\", \"anyOf\", \"oneOf\", \"enum\", \"const\")\n_PARSED_AS_JSON = \"application/json\"\n\n\ndef _operations(spec: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    return [\n        (f\"{method.upper()} {path}\", op)\n        for path, ops in spec[\"paths\"].items()\n        for method, op in ops.items()\n        if method in _METHODS\n    ]\n\n\ndef _constrains(schema: dict[str, Any] | None) -> bool:\n    return bool(schema) and any(key in schema for key in _CONSTRAINING_KEYS)  # type: ignore[union-attr]\n\n\ndef _untyped_successes(op: dict[str, Any]) -> list[str]:\n    bad = []\n    for code, response in op.get(\"responses\", {}).items():\n        if not code.startswith(\"2\") or code == \"204\":\n            continue\n        content = response.get(\"content\") or {}\n        if not content:\n            bad.append(f\"{code}: no content\")\n        bad.extend(\n            f\"{code} {media}: schema constrains nothing\"\n            for media, body in content.items()\n            if not _constrains(body.get(\"schema\"))\n        )\n    return bad\n\n\ndef _unmapped_media(op: dict[str, Any], overrides: dict[str, str]) -> list[str]:\n    \"\"\"Non-JSON success media the client generator would read as text or skip.\"\"\"\n    return [\n        media\n        for code, response in op.get(\"responses\", {}).items()\n        if code.startswith(\"2\")\n        for media in (response.get(\"content\") or {})\n        if media != _PARSED_AS_JSON and overrides.get(media) != \"application/octet-stream\"\n    ]\n\n\n@pytest.fixture(scope=\"module\")\ndef spec() -> dict[str, Any]:\n    return app.openapi()\n\n\n@pytest.fixture(scope=\"module\")\ndef overrides() -> dict[str, str]:\n    config = yaml.safe_load(_CLIENT_CONFIG.read_text())\n    return dict(config.get(\"content_type_overrides\") or {})\n\n\ndef test_the_spec_has_operations(spec: dict[str, Any]) -> None:\n    assert len(_operations(spec)) > 100\n\n\ndef test_every_success_response_is_typed(spec: dict[str, Any]) -> None:\n    untyped = {name: bad for name, op in _operations(spec) if (bad := _untyped_successes(op))}\n    assert untyped == {}\n\n\ndef test_every_file_download_is_mapped_for_the_client(\n    spec: dict[str, Any], overrides: dict[str, str]\n) -> None:\n    unmapped = {name: bad for name, op in _operations(spec) if (bad := _unmapped_media(op, overrides))}\n    assert unmapped == {}\n\n\n@pytest.mark.parametrize(\n    \"op\",\n    [\n        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {}}}}}},\n        {\"responses\": {\"200\": {\"content\": {\"application/json\": {\"schema\": {\"title\": \"R\"}}}}}},\n        {\n            \"responses\": {\n                \"201\": {\"content\": {\"application/json\": {\"schema\": {\"type\": \"object\"}}}},\n                \"200\": {\"content\": {\"application/json\": {\"schema\": {}}}},\n            }\n        },\n        {\"responses\": {\"200\": {\"description\": \"ok\"}}},\n    ],\n)\ndef test_an_untyped_success_is_refused(op: dict[str, Any]) -> None:\n    assert _untyped_successes(op)\n\n\ndef test_a_file_download_the_client_would_read_as_text_is_refused() -> None:\n    op = {\"responses\": {\"200\": {\"content\": {\"application/pdf\": {\"schema\": {\"type\": \"string\"}}}}}}\n    assert _unmapped_media(op, {}) == [\"application/pdf\"]\n    assert _unmapped_media(op, {\"application/pdf\": \"application/octet-stream\"}) == []\n"}},"serverClassifierRequest":"3ed67847-d3db-47a2-82da-767dc4c0a22a","apiBlockIndex":2,"requestId":"req_011CgEpeD6RcQ77v6NCD72eX","requestRef":"148a0a2a-1c5c-46ba-90ed-2606750237dd","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"94d6f6c0-2618-4738-b024-70e67430d2ad","timestamp":"2026-10-21T05:22:41.610Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/arijit/Coding/Python/DataQ","sessionId":"641b53ca-47b3-45aa-9ab6-6db8524d561d","version":"2.1.301","gitBranch":"fix/v13-ui-rule44"}
